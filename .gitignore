node_modules/

# Logs and debug
npm-debug.log*
*.log

# OS
.DS_Store

# Build / cache
# dist/ is committed on purpose: pi's git install runs `npm install --omit=dev`
# (no dev deps, no rebuild), so the prebuilt output must live in the repo.
build/
*.tsbuildinfo

# Env (keep .env.example if you add one)
.env
.env.*
!.env.example

# Test coverage
coverage/

# Eval outputs
/eval/artifacts/*
!/eval/artifacts/.gitkeep
/eval/results/*
!/eval/results/.gitkeep

# IDE (optional local junk)
.idea/
